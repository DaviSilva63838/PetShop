<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <Button
            android:id="@+id/btnVoltarAgenda"
            style="@style/BotaoSecundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/agenda_voltar" />

        <TextView
            style="@style/Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/agenda_titulo" />

        <TextView
            style="@style/Texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/agenda_instrucao" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/txtServicoAgenda"
                style="@style/Subtitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/txtPrecoAgenda"
                style="@style/Texto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/txtPetAgenda"
                style="@style/Texto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnCadastrarPetAgenda"
                style="@style/BotaoSecundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/agenda_cadastrar_pet"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            style="@style/Rotulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:labelFor="@id/btnDataAgenda"
            android:text="@string/agenda_data" />

        <Button
            android:id="@+id/btnDataAgenda"
            style="@style/BotaoSecundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/agenda_escolher_data" />

        <TextView
            style="@style/Rotulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:labelFor="@id/spnHorarioAgenda"
            android:text="@string/agenda_horario" />

        <Spinner
            android:id="@+id/spnHorarioAgenda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:spinnerMode="dropdown" />

        <TextView
            style="@style/Texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/agenda_duracao" />

        <Button
            android:id="@+id/btnConfirmarAgenda"
            style="@style/Botao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/agenda_confirmar" />
    </LinearLayout>
</ScrollView>
